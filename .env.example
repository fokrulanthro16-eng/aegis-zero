# AegisZero Environment Configuration
# YC Fall 2026 x Moss: The Zero Latency Builder Sprint

# LiveKit WebRTC Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Inference & Model Providers
GROQ_API_KEY=gsk_your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# Telemetry Server Settings
TELEMETRY_PORT=8080
TELEMETRY_HOST=0.0.0.0

# Zero-Latency Budget Limits (in milliseconds)
MOSS_LATENCY_BUDGET_MS=10.0
GUARDRAIL_LATENCY_BUDGET_MS=6.0
SPECULATIVE_TICK_INTERVAL_MS=100
MAX_SPECULATIVE_CANDIDATES=5
